# Browser configuration. Set the URL and publishable key from the same project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server configuration. Use the same URL. Paste the secret or legacy service_role key here only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ENVIRONMENT=
# Optional inbound support integration.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
