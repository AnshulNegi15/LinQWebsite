# Enable after applying the reviewed website migration.
DASHBOARD_REPORT_ENFORCEMENT=false
DASHBOARD_SUPPORT_REPLIES=false
RESEND_SEND_API_KEY=
SUPPORT_FROM_ADDRESS=
SUPPORT_REPLY_TO_ADDRESS=
